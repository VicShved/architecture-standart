@startuml c4_containers
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Банк «Стандарт» — контейнеры: открытие депозитов онлайн + передача ставок в кол-центр

' ─────────────────────────── Стили и легенда ───────────────────────────
' Подсветка компонентов, создаваемых в рамках решения
AddElementTag("new", $bgColor="#C8E6C9", $fontColor="#1B5E20", $borderColor="#2E7D32", $legendText="Новый компонент решения")
' Подсветка изменений Task4 — передача ставок в кол-центр
AddElementTag("task4", $bgColor="#FFE0B2", $fontColor="#E65100", $borderColor="#F57C00", $legendText="Изменения Task4 — передача ставок")

' ─────────────────────────── Персоны ───────────────────────────
Person(client, "Клиент", "Новый или действующий клиент банка")
Person(cc_operator, "Оператор кол-центра", "Сотрудник кол-центра банка")
Person(back_office, "Менеджер бэк-офиса депозитов", "Сотрудник бэк-офиса депозитных продуктов")
Person(front_office, "Сотрудник отделения", "Менеджер фронт-офиса сети отделений")

' ─────────────────────────── Внешние системы ───────────────────────────
System_Ext(sms_gw, "СМС-шлюз телеком-оператора", "Отправка СМС")
System_Ext(telco, "Система оператора связи", "Внешний телеком-оператор")
System_Ext(partner_cc, "Партнёрский кол-центр", "Внешняя система другого подрядчика")

' ═══════════════════════ Информационная система банка ═══════════════════════
System_Boundary(bank_bnd, "Информационная система банка") {

  ' ─────────────────────────── Депозиты ───────────────────────────
  System_Boundary(dep_bnd, "Депозиты") {
    Container(deposit_service, "Сервис депозитов", "Новый сервис, .NET + MS SQL (силы банка)", "Источник истины по ставкам (расчёт, согласование), заявки на депозит обоих каналов, подтверждение условий в MVP, идемпотентность, RBAC и аудит, Kafka", $tags="new")
    Container(rates_ui, "Рабочее место ведения ставок", "Новый веб-интерфейс, React.js", "Рабочее место бэк-офиса депозитов: ведение и согласование ставок (замена XLS), разграничение ролей", $tags="new")
    ContainerDb(deposit_db, "БД сервисов депозитов", "MS SQL", "Ставки, правила расчёта, заявки на депозит, аудит", $tags="new")
  }

  ' ─────────────────────────── Уведомления ───────────────────────────
  System_Boundary(notif_bnd, "Уведомления") {
    Container(notification_service, "Сервис уведомлений", "Новый сервис, .NET (силы банка)", "Отправка СМС-кодов и уведомлений по событиям Kafka через существующий СМС-шлюз, журналирование и ретраи", $tags="new")
  }

  ' ─────────────────────────── Интернет-банк ───────────────────────────
  System_Boundary(ib_bnd, "Интернет-банк") {
    Container(ib_gateway, "Шлюз API / балансировщик", "Новый, .NET/nginx", "TLS-терминация, маршрутизация запросов, горизонтальное масштабирование и балансировка между серверами и ЦОД", $tags="new")
    Container(ib_web, "Веб-интерфейс интернет-банка", "ASP.NET MVC 4.5 / .NET Framework 4.5 (подрядчик)", "UI: список депозитов и специальных ставок, форма заявки, ввод СМС-кода")
    Container(ib_core, "Сервис интернет-банка", ".NET Framework 4.5 (подрядчик)", "Существующая логика платежей и текущих счетов (дебетовых карт)")
    ContainerDb(ib_db, "БД интернет-банка", "MS SQL", "Существующие схемы (счета, платежи)")
  }

  ' ─────────────────────────── АБС ───────────────────────────
  System_Boundary(abs_bnd, "АБС") {
    Container(abs_front, "Рабочее место фронт-офиса", "Delphi (десктоп)", "Оформление депозита в отделении")
    Container(abs_core, "Сервис АБС", "Oracle PL/SQL (внутрибанковская разработка)", "Учёт операций по счетам и бухгалтерия, открытие депозита, ведение депозитов с зафиксированной ставкой")
    ContainerDb(abs_db, "БД Oracle (АБС)", "Oracle", "Схемы сервиса АБС и журнала событий (outbox)")
  }

  ' ─────────────────────────── Интеграция с АБС ───────────────────────────
  System_Boundary(abs_integration_bnd, "Интеграция с АБС") {
    Container(abs_integration, "Сервис интеграции с АБС", "Новый сервис, силы банка", "Единственная точка интеграции Kafka ↔ АБС: вызов PL/SQL с ограничением потока, публикация событий (депозит открыт)", $tags="new")
  }

  ' ─────────────────────────── Платформа / Общая инфраструктура ───────────────────────────
  System_Boundary(platform_bnd, "Платформа / Общая инфраструктура") {
    ContainerQueue(kafka, "Шина событий", "Kafka (платформа банка)", "Асинхронный обмен ставками, заявками и событиями между сервисами депозитов и АБС. Монолит интернет-банка с Kafka несовместим", $tags="new")
    ContainerDb(redis, "Кэш (Redis)", "Redis (новый)", "Кэш сервисов. Кэширует данные сервисов", $tags="new")
  }

  ' ─────────────────────────── Обмен с партнёрским кол-центром (Task4) ───────────────────────────
  System_Boundary(partner_exchange_bnd, "Обмен с партнёрским кол-центром") {
    ContainerQueue(sftp, "SFTP-сервер обмена", "SFTP/SSH (новый)", "Точка файлового обмена ставками с партнёрским кол-центром", $tags="task4")
  }

  ' ─────────────────────────── Сайт и система кол-центра (как системы) ───────────────────────────
  System(site, "Сайт", "PHP + React.js (собственная разработка): список депозитов с актуальными ставками, форма заявки (контактные данные)")
  System(cc, "Система кол-центра", "Платформа подрядчика: React.js, Java Spring Boot, PostgreSQL, микросервисы. Обработка обращений и заявок операторами")

  ' ─────────────────────────── Мониторинг (внизу диаграммы) ───────────────────────────
  System_Boundary(monitoring_bnd, "Мониторинг") {
    Container(monitoring_service, "Сервис мониторинга", "Новый сервис, силы банка", "Мониторинг доступности, метрик и журналов всех внутренних систем и инфраструктуры; алертинг", $tags="new")
  }
}

' ═══════════════════════════ Связи ═══════════════════════════
' UC-1, UC-2: сайт
Rel_Down(client, site, "Смотрит депозиты и актуальные ставки, подаёт заявку (контактные данные)", "HTTPS")
Rel(site, deposit_service, "Запрашивает ставки; передаёт заявку", "REST/HTTPS")

' UC-3: кол-центр
Rel_Down(cc_operator, cc, "Обрабатывает заявку, уточняет условия по депозиту", "")
Rel(cc, kafka, "Потребляет заявки с сайта и события о ставках, публикует предложенную ставку", "Kafka")

' UC-5, UC-6, UC-7: интернет-банк
Rel_Down(client, ib_gateway, "Смотрит ставки, подаёт заявку (счёт), вводит СМС-код", "HTTPS/TLS")
Rel(ib_gateway, ib_web, "Маршрутизирует запросы", "HTTP")
Rel(ib_web, deposit_service, "Запрашивает актуальные и специальные ставки, создаёт заявку, подтверждает СМС-код", "REST/HTTPS")
Rel(ib_web, ib_core, "Вызывает логику платежей/счетов", "")
Rel(ib_core, ib_db, "Читает/пишет счета и платежи", "SQL")

' UC-10: управление ставками (бэк-офис)
Rel_Down(back_office, rates_ui, "Ведёт и согласует ставки (вместо XLS)", "")
Rel(rates_ui, deposit_service, "Управляет ставками и правилами", "REST/HTTPS")

' UC-8: подтверждение условий в «Сервисе депозитов» (MVP)
Rel_Down(back_office, deposit_service, "Подтверждает условия депозита (MVP)", "REST")
Rel(deposit_service, deposit_db, "Читает/пишет ставки, правила, заявки, аудит", "SQL")
Rel(deposit_service, kafka, "Публикует заявки, запросы на отправку СМС-кода и подтверждённую ставку; потребляет события о ставках и открытии депозита", "Kafka")

' UC-4: оформление депозита в отделении
Rel_Down(front_office, abs_front, "Оформляет депозит в отделении", "")
Rel(abs_front, abs_core, "Открывает депозит, фиксирует ставку", "")
Rel(abs_core, abs_db, "Читает/пишет счета, бухгалтерию, депозиты", "SQL")

' Интеграция с АБС
Rel(abs_integration, kafka, "Потребляет заявки/ставки, публикует события (депозит открыт)", "Kafka")
Rel(abs_integration, abs_core, "Открывает депозит, фиксирует ставку", "PL/SQL")

' UC-9: уведомления
Rel(notification_service, kafka, "Потребляет события (запрос на отправку СМС-кода, ставка подтверждена, депозит открыт)", "Kafka")
Rel(notification_service, sms_gw, "Отправляет СМС-коды и уведомления", "HTTPS")
Rel(sms_gw, telco, "Передаёт СМС", "")
Rel_Up(telco, client, "Доставляет СМС", "")
Rel_Up(partner_cc, client, "Обзвон по скриптам банка", "")
Rel(partner_cc, deposit_service, "Передаёт результаты обзвона и подтверждённые заявки", "REST/HTTPS")

' Task4: передача ставок в партнёрский кол-центр через файловый обмен
Rel(deposit_service, sftp, "Выкладывает файл актуальных ставок", "SFTP/SSH")
Rel(partner_cc, sftp, "Забирает файл ставок по расписанию", "SFTP/SSH")

' Общий кэш (Redis): кэширует данные сервисов; ставки — только как локальный кэш сервиса
Rel(deposit_service, redis, "Кэширует данные сервиса", "Redis")
Rel(ib_web, redis, "Читает данные", "Redis")
Rel(ib_core, redis, "Кэширует данные сервиса", "Redis")
Rel(cc, redis, "Кэширует данные сервиса", "Redis")

' Мониторинг — по одной связи на каждую систему/границу
Rel_Up(monitoring_service, dep_bnd, "Мониторит", "")
Rel_Up(monitoring_service, notif_bnd, "Мониторит", "")
Rel_Up(monitoring_service, ib_bnd, "Мониторит", "")
Rel_Up(monitoring_service, abs_bnd, "Мониторит", "")
Rel_Up(monitoring_service, abs_integration_bnd, "Мониторит", "")
Rel_Up(monitoring_service, platform_bnd, "Мониторит", "")
Rel_Up(monitoring_service, site, "Мониторит", "")
Rel_Up(monitoring_service, cc, "Мониторит", "")
Rel_Up(monitoring_service, partner_exchange_bnd, "Мониторит", "$tags=task4")   ' Task4

' ─────────────────────────── Раскладка ───────────────────────────
' Держим всех персон над границей «Информационная система банка»
' (ib_gateway — верхний контейнер границы)
Lay_D(client, ib_gateway)
Lay_D(cc_operator, ib_gateway)
Lay_D(back_office, ib_gateway)
Lay_D(front_office, ib_gateway)

' Мониторинг держим внизу под самой верхней частью границы банка
Lay_D(ib_gateway, monitoring_service)

' ─────────────────────────── Легенда ───────────────────────────
SHOW_LEGEND()
@enduml
