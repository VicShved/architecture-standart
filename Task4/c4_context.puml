@startuml c4_context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Банк «Стандарт» — контекст передачи депозитных ставок в кол-центры (MVP)

' ─────────────────────────── Стили и легенда ───────────────────────────
AddRelTag("task4", $textColor="#E65100", $lineColor="#F57C00", $lineStyle="bold", $lineThickness="4", $legendText="Изменения Task4 — передача ставок (нет в Task3)")

' ─────────────────────────── Персоны ───────────────────────────
Person(client, "Клиент", "Новый или действующий клиент банка")
Person(cc_operator, "Оператор кол-центра", "Сотрудник кол-центра банка")
Person(back_office, "Менеджер бэк-офиса депозитов", "Сотрудник бэк-офиса депозитных продуктов")
Person(front_office, "Сотрудник отделения", "Менеджер фронт-офиса сети отделений")

' ─────────────────────────── Система банка ───────────────────────────
System(bank, "Информационная система банка", "Сайт, интернет-банк, система кол-центра, АБС и сервисы депозитов: ставки, заявки, учёт и открытие депозитов; публикация ставок и файловый обмен с партнёром")

' ─────────────────────────── Внешние системы ───────────────────────────
System_Ext(partner_cc, "Партнёрский кол-центр", "Внешняя система другого подрядчика. Обзвон по скриптам банка; получает актуальные депозитные ставки файловым обменом")
System_Ext(sms_gw, "СМС-шлюз телеком-оператора", "Отправка СМС. Сопровождается IT-отделом банка")
System_Ext(telco, "Система оператора связи", "Внешний телеком-оператор доставки СМС")

' ─────────────────────────── Связи ───────────────────────────
Rel(client, bank, "Просматривает депозиты и ставки, подаёт заявку (контактные данные; счёт), подтверждает СМС-кодом", "HTTPS")
Rel(cc_operator, bank, "Обрабатывает заявку, консультирует по актуальным ставкам депозитов", "")
Rel(back_office, bank, "Ведёт и согласует ставки, подтверждает условия депозита (MVP)", "")
Rel(client, front_office, "Приходит в отделение для оформления депозита", "")
Rel(front_office, bank, "Оформляет депозит в отделении", "")

Rel(bank, sms_gw, "Отправляет СМС-коды и уведомления", "HTTPS")
Rel(sms_gw, telco, "Передаёт СМС", "")
Rel(telco, client, "Доставляет СМС", "")
Rel(partner_cc, client, "Обзвон по скриптам банка (в т.ч. по актуальным ставкам депозитов)", "")
Rel(partner_cc, bank, "Передаёт результаты обзвона и подтверждённые заявки", "HTTPS/REST")

' Task4: передача актуальных депозитных ставок внешнему (партнёрскому) кол-центру
Rel(bank, partner_cc, "Передаёт актуальные депозитные ставки", "SFTP (файловый обмен)", $tags="task4")

SHOW_LEGEND()
@enduml
