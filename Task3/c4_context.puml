@startuml c4_context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Банк «Стандарт» — контекст открытия депозитов онлайн (MVP)

' ─────────────────────────── Персоны ───────────────────────────
Person(client, "Клиент", "Новый или действующий клиент банка")
Person(cc_operator, "Оператор кол-центра", "Сотрудник кол-центра банка")
Person(back_office, "Менеджер бэк-офиса депозитов", "Сотрудник бэк-офиса депозитных продуктов")
Person(front_office, "Сотрудник отделения", "Менеджер фронт-офиса сети отделений")

' ─────────────────────────── Система банка ───────────────────────────
System(bank, "Информационная система банка", "Сайт, интернет-банк, система кол-центра, АБС и сервисы депозитов: просмотр ставок, подача заявок, подтверждение условий, учёт и открытие депозитов")

' ─────────────────────────── Внешние системы ───────────────────────────
System_Ext(partner_cc, "Партнёрский кол-центр", "Внешняя система другого подрядчика. Обзвон по скриптам банка")
System_Ext(sms_gw, "СМС-шлюз телеком-оператора", "Отправка СМС. Сопровождается IT-отделом банка")
System_Ext(telco, "Система оператора связи", "Внешний телеком-оператор доставки СМС")

' ─────────────────────────── Связи ───────────────────────────
Rel(client, bank, "Просматривает депозиты и ставки, подаёт заявку (контактные данные; счёт), подтверждает СМС-кодом", "HTTPS")
Rel(cc_operator, bank, "Обрабатывает заявку, уточняет условия по депозиту", "")
Rel(back_office, bank, "Ведёт и согласует ставки, подтверждает условия депозита (MVP)", "")
Rel(client, front_office, "Приходит в отделение для оформления депозита", "")
Rel(front_office, bank, "Оформляет депозит в отделении", "")

Rel(bank, sms_gw, "Отправляет СМС-коды и уведомления", "HTTPS")
Rel(sms_gw, telco, "Передаёт СМС", "")
Rel(telco, client, "Доставляет СМС", "")
Rel(partner_cc, client, "Обзвон по скриптам банка", "")
Rel(partner_cc, bank, "Передаёт результаты обзвона и подтверждённые заявки", "HTTPS/REST")
@enduml
